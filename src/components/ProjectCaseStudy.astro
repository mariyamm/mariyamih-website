---
interface MetaItem {
  icon: string;
  label: string;
  value: string;
}

interface ListSection {
  icon: string;
  label: string;
  items: string[];
}

interface StepItem {
  icon: string;
  title: string;
  description: string;
}

interface FeatureItem {
  icon: string;
  title: string;
  description: string;
}

interface ContributionItem {
  icon: string;
  title: string;
  description: string;
}

interface ImpactTrend {
  kind: "trend";
  value: string;
  title: string;
  description: string;
}

interface ImpactRing {
  kind: "ring";
  percent: number;
  value: string;
  title: string;
  description: string;
}

interface ImpactRating {
  kind: "rating";
  stars: number;
  title: string;
  description: string;
}

interface ImpactBars {
  kind: "bars";
  title: string;
  description: string;
}

type ImpactCard = ImpactTrend | ImpactRing | ImpactRating | ImpactBars;

interface ToolItem {
  icon: string;
  label: string;
}

interface MatteredItem {
  icon: string;
  title: string;
  description: string;
}

export interface Props {
  title: string;
  tagline: string;
  description: string;
  heroImage?: string;
  heroImageAlt?: string;
  backLink?: string;
  meta: MetaItem[];
  challenge: ListSection;
  solution: ListSection;
  steps: StepItem[];
  features: FeatureItem[];
  contributions: ContributionItem[];
  impact: ImpactCard[];
  techStack: ToolItem[];
  mattered: MatteredItem[];
  ctaHeading?: string;
  ctaDescription?: string;
}

const {
  title,
  tagline,
  description,
  heroImage,
  heroImageAlt,
  backLink = "/projects",
  meta,
  challenge,
  solution,
  steps,
  features,
  contributions,
  impact,
  techStack,
  mattered,
  ctaHeading = "Want something similar for your team?",
  ctaDescription = "Let's explore how AI can transform your operations.",
} = Astro.props;
---

<main class="case-study">
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="label">Case Study</p>

        <h1>{title}</h1>

        <p class="tagline">{tagline}</p>
        <p class="description">{description}</p>

        <div class="meta-grid">
          {
            meta.map((item) => (
              <div class="meta-item">
                <span class="meta-icon" set:html={item.icon} />
                <div>
                  <p class="meta-label">{item.label}</p>
                  <p class="meta-value">{item.value}</p>
                </div>
              </div>
            ))
          }
        </div>

        <div class="buttons">
          <a href={backLink} class="secondary-button">
            <span aria-hidden="true">←</span>
            Back to projects
          </a>

          <a href="/contact" class="primary-button">
            Book a consultation
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="hero-visual">
        <slot name="heroVisual">
          <img src={heroImage} alt={heroImageAlt} class="hero-image" />
        </slot>
      </div>
    </div>
  </section>

  <section class="challenge-solution">
    <div class="challenge-solution-inner">
      <div class="cs-card">
        <p class="cs-label">
          <span class="cs-label-icon" set:html={challenge.icon} />
          {challenge.label}
        </p>
        <ul class="cs-list">
          {challenge.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="cs-card">
        <p class="cs-label">
          <span class="cs-label-icon" set:html={solution.icon} />
          {solution.label}
        </p>
        <ul class="cs-list">
          {solution.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="how-it-works">
    <div class="how-it-works-inner">
      <p class="section-label">How It Works</p>

      <div class="steps-row">
        {
          steps.map((step) => (
            <div class="step-card">
              <span class="step-icon" set:html={step.icon} />
              <p class="step-title">{step.title}</p>
              <p class="step-description">{step.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="key-features">
    <div class="key-features-inner">
      <p class="section-label">Key Features</p>

      <div class="features-grid">
        {
          features.map((feature) => (
            <div class="feature-card">
              <span class="feature-icon" set:html={feature.icon} />
              <p class="feature-title">{feature.title}</p>
              <p class="feature-description">{feature.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="contribution">
    <div class="contribution-inner">
      <p class="section-label">My Contribution</p>

      <div class="contribution-grid">
        {
          contributions.map((item) => (
            <div class="contribution-card">
              <span class="contribution-icon" set:html={item.icon} />
              <p class="contribution-title">{item.title}</p>
              <p class="contribution-description">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="impact">
    <div class="impact-inner">
      <p class="section-label">Business Impact (MVP Outcomes)</p>

      <div class="impact-grid">
        {
          impact.map((card) => (
            <div class="impact-card">
              {card.kind === "trend" && (
                <>
                  <p class="impact-value">{card.value}</p>
                  <p class="impact-title">{card.title}</p>
                  <p class="impact-description">{card.description}</p>
                  <svg class="impact-graphic" viewBox="0 0 120 40" preserveAspectRatio="none">
                    <polyline
                      points="0,36 20,30 40,32 60,18 80,20 100,6 120,4"
                      fill="none"
                      stroke="#45c7ff"
                      stroke-width="2.4"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </>
              )}

              {card.kind === "ring" && (
                <>
                  <div
                    class="impact-ring"
                    style={`--percent:${card.percent}`}
                  >
                    <span>{card.value}</span>
                  </div>
                  <p class="impact-title">{card.title}</p>
                  <p class="impact-description">{card.description}</p>
                </>
              )}

              {card.kind === "rating" && (
                <>
                  <p class="impact-title">{card.title}</p>
                  <div class="impact-stars" aria-hidden="true">
                    {Array.from({ length: 5 }).map((_, index) => (
                      <span
                        class:list={[
                          "impact-star",
                          index < card.stars && "impact-star-filled",
                        ]}
                      >
                        ★
                      </span>
                    ))}
                  </div>
                  <p class="impact-description">{card.description}</p>
                </>
              )}

              {card.kind === "bars" && (
                <>
                  <p class="impact-title">{card.title}</p>
                  <div class="impact-bars" aria-hidden="true">
                    {[40, 55, 45, 70, 60, 85, 95].map((height) => (
                      <span
                        class="impact-bar"
                        style={`--h:${height}%`}
                      />
                    ))}
                  </div>
                  <p class="impact-description">{card.description}</p>
                </>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="tech-stack">
    <div class="tech-stack-inner">
      <p class="section-label">Tech Stack</p>

      <div class="tech-stack-row">
        {
          techStack.map((tool) => (
            <div class="tech-pill">
              <span class="tech-pill-icon" set:html={tool.icon} />
              {tool.label}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mattered">
    <div class="mattered-inner">
      <p class="section-label">What Mattered Most</p>

      <div class="mattered-grid">
        {
          mattered.map((item) => (
            <div class="mattered-card">
              <span class="mattered-icon" set:html={item.icon} />
              <p class="mattered-title">{item.title}</p>
              <p class="mattered-description">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="case-cta">
    <div class="case-cta-inner">
      <h2>{ctaHeading}</h2>
      <p class="case-cta-description">{ctaDescription}</p>

      <a href="/contact" class="primary-button">
        Start a conversation
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</main>

<style>
  .case-study {
    display: block;
  }

  .label {
    width: fit-content;
    margin: 0 0 22px;
    border: 1px solid rgba(69, 199, 255, 0.58);
    border-radius: 4px;
    color: #45c7ff;
    padding: 9px 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .section-label {
    margin: 0 0 24px;
    color: #1d63ff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .primary-button,
  .secondary-button {
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: 5px;
    padding: 0 22px;
    font-weight: 700;
    font-size: 14.5px;
    text-decoration: none;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background 180ms ease;
  }

  .primary-button:hover,
  .secondary-button:hover {
    transform: translateY(-2px);
  }

  .primary-button {
    background: #1d63ff;
    color: white;
    box-shadow: 0 14px 32px rgba(29, 99, 255, 0.28);
  }

  .primary-button:hover {
    background: #3476ff;
  }

  .secondary-button {
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: white;
  }

  .secondary-button:hover {
    border-color: rgba(69, 199, 255, 0.7);
  }

  /* ---------- Hero ---------- */

  .hero {
    padding: 40px 0 60px;
  }

  .hero-inner {
    display: grid;
    width: min(1180px, calc(100% - 48px));
    grid-template-columns: 0.85fr 1.15fr;
    align-items: center;
    gap: 50px;
    margin: 0 auto;
  }

  h1 {
    max-width: 480px;
    margin: 0;
    font-size: clamp(30px, 3.6vw, 42px);
    line-height: 1.12;
    letter-spacing: -0.03em;
  }

  .tagline {
    max-width: 440px;
    margin: 18px 0 0;
    color: rgba(245, 247, 250, 0.75);
    font-size: 15.5px;
    line-height: 1.6;
  }

  .description {
    max-width: 460px;
    margin: 14px 0 0;
    color: rgba(245, 247, 250, 0.5);
    font-size: 13.5px;
    line-height: 1.65;
  }

  .meta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 26px;
  }

  .meta-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.03);
    padding: 12px 14px;
  }

  .meta-icon {
    display: flex;
    width: 26px;
    height: 26px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    background: rgba(69, 199, 255, 0.12);
    color: #45c7ff;
  }

  .meta-icon :global(svg) {
    width: 14px;
    height: 14px;
  }

  .meta-label {
    margin: 0 0 2px;
    color: rgba(245, 247, 250, 0.45);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .meta-value {
    margin: 0;
    color: #f5f7fa;
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1.35;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }

  .hero-visual {
    position: relative;
  }

  .hero-image {
    width: 100%;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 14px;
    box-shadow: 0 30px 60px rgba(2, 8, 20, 0.45);
  }

  /* ---------- Challenge / Solution ---------- */

  .challenge-solution {
    padding-bottom: 70px;
  }

  .challenge-solution-inner {
    display: grid;
    width: min(1180px, calc(100% - 48px));
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin: 0 auto;
  }

  .cs-card {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.03);
    padding: 26px 26px;
  }

  .cs-label {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 18px;
    color: #45c7ff;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .cs-label-icon {
    display: flex;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background: rgba(69, 199, 255, 0.12);
  }

  .cs-label-icon :global(svg) {
    width: 15px;
    height: 15px;
  }

  .cs-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cs-list li {
    position: relative;
    padding-left: 18px;
    color: rgba(245, 247, 250, 0.68);
    font-size: 13.5px;
    line-height: 1.5;
  }

  .cs-list li::before {
    position: absolute;
    top: 6px;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #45c7ff;
    content: "";
  }

  /* ---------- How it works ---------- */

  .how-it-works {
    background: #0a1830;
    padding: 70px 0;
  }

  .how-it-works-inner {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .steps-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    max-width: 980px;
    margin: 0 auto;
  }

  .step-card {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    padding: 18px 14px;
    text-align: center;
  }

  .step-card:not(:last-child)::after {
    position: absolute;
    top: 33px;
    right: -18px;
    width: 22px;
    height: 1px;
    background-image: linear-gradient(
      to right,
      rgba(69, 199, 255, 0.5) 50%,
      transparent 50%
    );
    background-size: 8px 1px;
    content: "";
  }

  .step-icon {
    display: flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    margin: 0 auto 12px;
    border-radius: 50%;
    background: rgba(69, 199, 255, 0.12);
    color: #45c7ff;
  }

  .step-icon :global(svg) {
    width: 18px;
    height: 18px;
  }

  .step-title {
    margin: 0 0 6px;
    font-size: 13.5px;
    font-weight: 700;
  }

  .step-description {
    margin: 0;
    color: rgba(245, 247, 250, 0.5);
    font-size: 11.5px;
    line-height: 1.5;
  }

  /* ---------- Key features ---------- */

  .key-features {
    background: #061426;
    padding: 70px 0;
  }

  .key-features-inner {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .feature-card {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    padding: 20px 18px;
    transition:
      border-color 180ms ease,
      background 180ms ease;
  }

  .feature-card:hover {
    border-color: rgba(69, 199, 255, 0.35);
    background: rgba(255, 255, 255, 0.05);
  }

  .feature-icon {
    display: flex;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    border-radius: 9px;
    background: rgba(69, 199, 255, 0.12);
    color: #45c7ff;
  }

  .feature-icon :global(svg) {
    width: 18px;
    height: 18px;
  }

  .feature-title {
    margin: 0 0 6px;
    font-size: 14px;
    font-weight: 700;
  }

  .feature-description {
    margin: 0;
    color: rgba(245, 247, 250, 0.55);
    font-size: 12.5px;
    line-height: 1.55;
  }

  /* ---------- Contribution ---------- */

  .contribution {
    background: #0a1830;
    padding: 70px 0;
  }

  .contribution-inner {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .contribution-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .contribution-card {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    padding: 22px 18px;
  }

  .contribution-icon {
    display: flex;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    border-radius: 9px;
    background: rgba(69, 199, 255, 0.12);
    color: #45c7ff;
  }

  .contribution-icon :global(svg) {
    width: 18px;
    height: 18px;
  }

  .contribution-title {
    margin: 0 0 8px;
    font-size: 14px;
    font-weight: 700;
  }

  .contribution-description {
    margin: 0;
    color: rgba(245, 247, 250, 0.55);
    font-size: 12.5px;
    line-height: 1.55;
  }

  /* ---------- Impact ---------- */

  .impact {
    background: #061426;
    padding: 70px 0;
  }

  .impact-inner {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .impact-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .impact-card {
    position: relative;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.03);
    padding: 22px 20px;
    overflow: hidden;
  }

  .impact-value {
    margin: 0 0 4px;
    color: #45c7ff;
    font-size: 26px;
    font-weight: 800;
  }

  .impact-title {
    margin: 0 0 8px;
    font-size: 13.5px;
    font-weight: 700;
    line-height: 1.4;
  }

  .impact-description {
    position: relative;
    z-index: 1;
    margin: 0;
    color: rgba(245, 247, 250, 0.5);
    font-size: 12px;
    line-height: 1.55;
  }

  .impact-graphic {
    display: block;
    width: 100%;
    height: 32px;
    margin-top: 12px;
  }

  .impact-ring {
    --percent: 30;
    position: relative;
    display: flex;
    width: 64px;
    height: 64px;
    align-items: center;
    justify-content: center;
    margin-bottom: 10px;
    border-radius: 50%;
    background: conic-gradient(
      #45c7ff calc(var(--percent) * 1%),
      rgba(255, 255, 255, 0.08) 0
    );
  }

  .impact-ring::before {
    position: absolute;
    inset: 6px;
    border-radius: 50%;
    background: #0b1c37;
    content: "";
  }

  .impact-ring span {
    position: relative;
    z-index: 1;
    color: #ffffff;
    font-size: 13px;
    font-weight: 800;
  }

  .impact-stars {
    display: flex;
    gap: 4px;
    margin-bottom: 10px;
  }

  .impact-star {
    color: rgba(255, 255, 255, 0.15);
    font-size: 15px;
  }

  .impact-star-filled {
    color: #45c7ff;
  }

  .impact-bars {
    display: flex;
    align-items: flex-end;
    gap: 5px;
    height: 34px;
    margin-bottom: 10px;
  }

  .impact-bar {
    display: block;
    width: 8px;
    height: var(--h);
    border-radius: 3px 3px 0 0;
    background: #45c7ff;
    opacity: 0.85;
  }

  /* ---------- Tech stack ---------- */

  .tech-stack {
    background: #0a1830;
    padding: 60px 0;
  }

  .tech-stack-inner {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .tech-stack-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .tech-pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 9px;
    background: rgba(255, 255, 255, 0.03);
    padding: 11px 16px;
    color: rgba(245, 247, 250, 0.75);
    font-size: 13px;
    font-weight: 600;
  }

  .tech-pill-icon {
    display: flex;
    color: #45c7ff;
  }

  .tech-pill-icon :global(svg) {
    width: 16px;
    height: 16px;
  }

  /* ---------- What mattered most ---------- */

  .mattered {
    background: #061426;
    padding: 70px 0;
  }

  .mattered-inner {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .mattered-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .mattered-card {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.03);
    padding: 24px 22px;
  }

  .mattered-icon {
    display: flex;
    width: 38px;
    height: 38px;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    border-radius: 10px;
    background: rgba(69, 199, 255, 0.12);
    color: #45c7ff;
  }

  .mattered-icon :global(svg) {
    width: 19px;
    height: 19px;
  }

  .mattered-title {
    margin: 0 0 8px;
    font-size: 14.5px;
    font-weight: 700;
  }

  .mattered-description {
    margin: 0;
    color: rgba(245, 247, 250, 0.55);
