---
const pageTitle = "E-commerce Intelligence Dashboard | Mariya Mihaylova";

const icons = {
  mail: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>',
  pin: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.4 7-11.5A7 7 0 0 0 5 9.5C5 14.6 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.3"/></svg>',
  globe:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>',
  briefcase:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="7" width="18" height="12" rx="2"/><path d="M9 7V5h6v2M3 12h18"/></svg>',
  clock:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>',
  stack:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5"/></svg>',
  spark: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><path d="M12 7v10M7 12h10"/></svg>',
  chat: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5h14a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H10l-5 4v-4H3a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"/><circle cx="6.5" cy="10.5" r=".9" fill="currentColor" stroke="none"/><circle cx="10.5" cy="10.5" r=".9" fill="currentColor" stroke="none"/><circle cx="14.5" cy="10.5" r=".9" fill="currentColor" stroke="none"/></svg>',
  bulb: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6M10 21h4M8.5 14A5.5 5.5 0 1 1 15.5 14c-.7 1-1.5 1.6-1.5 3h-4c0-1.4-.8-2-1.5-3z"/></svg>',
  database:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5.5" rx="8" ry="2.8"/><path d="M4 5.5V18c0 1.5 3.6 2.8 8 2.8s8-1.3 8-2.8V5.5"/><path d="M4 12c0 1.5 3.6 2.8 8 2.8s8-1.3 8-2.8"/></svg>',
  search:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.3-4.3"/></svg>',
  check: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4 4L19 2.5"/></svg>',
  bar: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>',
  target:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4.4"/><circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none"/></svg>',
  gear: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3.2"/><path d="M12 3v2.4M12 18.6V21M21 12h-2.4M5.4 12H3M18 6l-1.7 1.7M7.7 16.3 6 18M18 18l-1.7-1.7M7.7 7.7 6 6"/></svg>',
  layers:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13.5l9 5 9-5"/><path d="M3 8.5l9 5 9-5"/></svg>',
  rocket:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2c3 2 5 6 5 10 0 2-1 4-2 5l-3 3-3-3c-1-1-2-3-2-5 0-4 2-8 5-10z"/><circle cx="12" cy="10" r="1.6" fill="currentColor" stroke="none"/><path d="M8.5 16 6 21l3-1.5M15.5 16 18 21l-3-1.5"/></svg>',
  monitor:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>',
  list: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6h11M9 12h11M9 18h11"/><circle cx="4.5" cy="6" r="1.3" fill="currentColor" stroke="none"/><circle cx="4.5" cy="12" r="1.3" fill="currentColor" stroke="none"/><circle cx="4.5" cy="18" r="1.3" fill="currentColor" stroke="none"/></svg>',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="E-commerce Intelligence Dashboard case study powered by AI and data-driven decision-making."
    />
    <title>{pageTitle}</title>
  </head>

  <body>
    <header>
      <nav>
        <a href="/" class="logo" aria-label="Mariya Mihaylova homepage">
          MM
        </a>

        <div class="navigation">
          <a href="/">Home</a>
          <a href="/expertise">Expertise</a>
          <a href="/projects" class="active-page">Projects</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>

          <div class="language-switcher" aria-label="Language selector">
            <a href="/" class="active-language">EN</a>
            <span>|</span>
            <a href="/fr">FR</a>
          </div>
        </div>
      </nav>
    </header>

    <main class="case-study-page">
      <section class="hero">
        <div class="hero-inner">
          <div class="hero-copy">
            <p class="label">Case Study</p>

            <h1>E-commerce<br />Intelligence Dashboard</h1>

            <p class="tagline">
              A real-time analytics dashboard connecting sales, customer and operational data to support faster decisions.
            </p>

            <div class="meta-grid">
              <div class="meta-item">
                <span class="meta-icon" set:html={icons.briefcase} />
                <div>
                  <p class="meta-label">Role</p>
                  <p class="meta-value">Product / Delivery</p>
                </div>
              </div>

              <div class="meta-item">
                <span class="meta-icon" set:html={icons.stack} />
                <div>
                  <p class="meta-label">Industry</p>
                  <p class="meta-value">E-commerce</p>
                </div>
              </div>

              <div class="meta-item">
                <span class="meta-icon" set:html={icons.clock} />
                <div>
                  <p class="meta-label">Timeline</p>
                  <p class="meta-value">8-12 weeks</p>
                </div>
              </div>

              <div class="meta-item">
                <span class="meta-icon" set:html={icons.layers} />
                <div>
                  <p class="meta-label">Stack</p>
                  <p class="meta-value">SQL, BigQuery, Looker, Shopify, Python</p>
                </div>
              </div>
            </div>

            <div class="buttons">
              <a href="/projects" class="secondary-button">
                <span aria-hidden="true">←</span>
                Back to projects
              </a>

              <a href="/contact" class="primary-button">
                Book a consultation
                <span aria-hidden="true">→</span>
              </a>
            </div>
          </div>

          <div class="hero-visual" aria-label="E-commerce intelligence dashboard preview">
            <div class="dashboard-shell">
              <div class="dashboard-topbar">
                <div class="topbar-left">
                  <span class="window-dot" />
                  <span class="window-dot" />
                  <span class="window-dot" />
                </div>
                <div class="topbar-right">
                  <span>Overview</span>
                  <span class="topbar-pill">May 1 - May 30, 2024</span>
                </div>
              </div>

              <div class="dashboard-content">
                <aside class="dashboard-sidebar">
                  <p class="sidebar-group">Overview</p>
                  <ul>
                    <li class="active">Overview</li>
                    <li>Sales</li>
                    <li>Retail Revenue</li>
                    <li>Orders</li>
                    <li>Avg. Order Value</li>
                    <li>Gross Margin</li>
                    <li>Customers</li>
                    <li>Products</li>
                    <li>Marketing</li>
                    <li>Operations</li>
                  </ul>
                </aside>

                <div class="dashboard-main">
                  <div class="kpi-row">
                    <div class="kpi-box">
                      <span class="kpi-label">Revenue</span>
                      <strong>$2.48M</strong>
                      <small>+15.2%</small>
                    </div>
                    <div class="kpi-box">
                      <span class="kpi-label">Orders</span>
                      <strong>24,560</strong>
                      <small>+4.2%</small>
                    </div>
                    <div class="kpi-box">
                      <span class="kpi-label">AOV</span>
                      <strong>$101.23</strong>
                      <small>+3.2%</small>
                    </div>
                    <div class="kpi-box">
                      <span class="kpi-label">Gross Margin</span>
                      <strong>42.7%</strong>
                      <small>+1.3%</small>
                    </div>
                  </div>

                  <div class="main-panel-grid">
                    <div class="panel panel-chart">
                      <div class="panel-header">
                        <span>Revenue over time</span>
                        <span>Monthly</span>
                      </div>
                      <svg viewBox="0 0 340 160" preserveAspectRatio="none">
                        <polyline points="0,120 30,110 60,118 90,82 120,94 150,54 180,70 210,34 240,48 270,50 300,28 340,38" fill="none" stroke="#45c7ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                        <polyline points="0,138 30,132 60,136 90,108 120,116 150,96 180,102 210,86 240,90 270,78 300,82 340,74" fill="none" stroke="#86d7ff" stroke-width="2.5" opacity="0.6" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </div>

                    <div class="panel panel-pie">
                      <div class="panel-header">
                        <span>Channel mix</span>
                        <span>Live</span>
                      </div>
                      <div class="donut-wrap">
                        <div class="donut-chart">
                          <span>42.3%</span>
                        </div>
                      </div>
                    </div>
                  </div>

                  <div class="bottom-grid">
                    <div class="panel panel-table">
                      <div class="panel-header">
                        <span>Customer retention</span>
                        <span>Weekly</span>
                      </div>
                      <table>
                        <tr><td>Week 1</td><td>82%</td></tr>
                        <tr><td>Week 2</td><td>84%</td></tr>
                        <tr><td>Week 3</td><td>87%</td></tr>
                        <tr><td>Week 4</td><td>90%</td></tr>
                        <tr><td>Week 5</td><td>91%</td></tr>
                      </table>
                    </div>

                    <div class="panel panel-table">
                      <div class="panel-header">
                        <span>Operational KPIs</span>
                        <span>Live</span>
                      </div>
                      <table>
                        <tr><td>On time delivery</td><td>96.3%</td></tr>
                        <tr><td>Return rate</td><td>4.2%</td></tr>
                        <tr><td>Inventory accuracy</td><td>92%</td></tr>
                        <tr><td>Fulfillment SLA</td><td>98.1%</td></tr>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="challenge-solution">
        <div class="challenge-solution-inner">
          <div class="cs-card">
            <p class="cs-label">
              <span class="cs-label-icon" set:html={icons.bulb} />
              The Challenge
            </p>
            <ul class="cs-list">
              <li>Data was fragmented across sales, marketing, customer support and operations systems.</li>
              <li>Leadership needed a clear view of performance across channels, fulfillment and retention.</li>
              <li>Limited visibility into real-time performance and operational efficiency.</li>
              <li>Teams spent more time preparing reports than acting on them.</li>
            </ul>
          </div>

          <div class="cs-card">
            <p class="cs-label">
              <span class="cs-label-icon" set:html={icons.spark} />
              The Solution
            </p>
            <ul class="cs-list">
              <li>Built a centralized analytics dashboard with a single source of truth across key business areas.</li>
              <li>Unified KPIs and definitions to ensure consistency and comparability.</li>
              <li>Near-real-time data pipeline for timely monitoring and alerts.</li>
              <li>Clear, actionable insights tailored to business users.</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="how-it-works">
        <div class="how-it-works-inner">
          <p class="section-label">How It Works</p>

          <div class="steps-row">
            <div class="step-card">
              <span class="step-icon" set:html={icons.database} />
              <p class="step-title">Source Systems</p>
              <p class="step-description">Shopify, GA4, CRM, ERP, support &amp; returns data.</p>
            </div>

            <div class="step-card">
              <span class="step-icon" set:html={icons.search} />
              <p class="step-title">Data Ingestion</p>
              <p class="step-description">Automated pipelines scheduled throughout the day.</p>
            </div>

            <div class="step-card">
              <span class="step-icon" set:html={icons.layers} />
              <p class="step-title">Warehousing &amp; Modeling</p>
              <p class="step-description">Cleaned, joined and structured data across business domains.</p>
            </div>

            <div class="step-card">
              <span class="step-icon" set:html={icons.monitor} />
              <p class="step-title">KPI Dashboard</p>
              <p class="step-description">Looker dashboard with interactive visuals and drill-downs.</p>
            </div>

            <div class="step-card">
              <span class="step-icon" set:html={icons.check} />
              <p class="step-title">Decision Making</p>
              <p class="step-description">Teams monitor trends and act with confidence.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="key-features">
        <div class="key-features-inner">
          <p class="section-label">Key Features</p>

          <div class="features-grid">
            <div class="feature-card">
              <span class="feature-icon" set:html={icons.bar} />
              <p class="feature-title">Sales Overview</p>
              <p class="feature-description">Track revenue, orders and conversion trends at a glance.</p>
            </div>

            <div class="feature-card">
              <span class="feature-icon" set:html={icons.target} />
              <p class="feature-title">Order Trends</p>
              <p class="feature-description">Monitor order volume, fulfillment and demand patterns over time.</p>
            </div>

            <div class="feature-card">
              <span class="feature-icon" set:html={icons.chat} />
              <p class="feature-title">Customer Insights</p>
              <p class="feature-description">Understand retention, LTV, channel behavior and customer segments.</p>
            </div>

            <div class="feature-card">
              <span class="feature-icon" set:html={icons.gear} />
              <p class="feature-title">Channel Performance</p>
              <p class="feature-description">Analyze performance by campaign, channel and traffic source.</p>
            </div>

            <div class="feature-card">
              <span class="feature-icon" set:html={icons.monitor} />
              <p class="feature-title">Product Performance</p>
              <p class="feature-description">Identify top products, inventory issues and conversion opportunities.</p>
            </div>

            <div class="feature-card">
              <span class="feature-icon" set:html={icons.rocket} />
              <p class="feature-title">Returns &amp; Operations</p>
              <p class="feature-description">Monitor return rates, shipping quality and operational performance.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="contribution-impact">
        <div class="contribution-impact-inner">
          <div class="contribution-panel">
            <p class="section-label">My Contribution</p>
            <ul class="contribution-list">
              <li>Defined success metrics and KPI framework with stakeholders.</li>
              <li>Led discovery, requirements gathering and dashboard scope.</li>
              <li>Designed data model and KPI logic in collaboration with the team.</li>
              <li>Coordinated data integration and dashboard implementation.</li>
              <li>Validated data quality and monitored performance after launch.</li>
              <li>Led user training, documentation and stakeholder rollout.</li>
            </ul>
          </div>

          <div class="impact-panel">
            <p class="section-label">Business Impact</p>

            <div class="impact-grid">
              <div class="impact-card">
                <p class="impact-value">80%</p>
                <p class="impact-title">Faster reporting</p>
                <p class="impact-description">Reporting time cut from days to hours.</p>
              </div>

              <div class="impact-card">
                <p class="impact-value">45%</p>
                <p class="impact-title">Reduction in manual work</p>
                <p class="impact-description">Less spreadsheet work and easier stakeholder alignment.</p>
              </div>

              <div class="impact-card">
                <p class="impact-value">30%</p>
                <p class="impact-title">Increase in visibility</p>
                <p class="impact-description">Better data coverage across teams and functions.</p>
              </div>

              <div class="impact-card">
                <p class="impact-value">Better</p>
                <p class="impact-title">Decision-making</p>
                <p class="impact-description">Faster, clearer decisions across sales and operations.</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="tech-stack">
        <div class="tech-stack-inner">
          <p class="section-label">Tech Stack</p>

          <div class="tech-stack-row">
            <span class="tech-pill"><span class="tech-pill-icon" set:html={icons.database} />SQL</span>
            <span class="tech-pill"><span class="tech-pill-icon" set:html={icons.search} />BigQuery</span>
            <span class="tech-pill"><span class="tech-pill-icon" set:html={icons.monitor} />Looker</span>
            <span class="tech-pill"><span class="tech-pill-icon" set:html={icons.spark} />Shopify</span>
            <span class="tech-pill"><span class="tech-pill-icon" set:html={icons.bar} />Google Analytics 4</span>
            <span class="tech-pill"><span class="tech-pill-icon" set:html={icons.gear} />Python</span>
            <span class="tech-pill"><span class="tech-pill-icon" set:html={icons.layers} />Data Studio</span>
          </div>
        </div>
      </section>

      <section class="case-cta">
        <div class="case-cta-inner">
          <h2>Let’s build something useful.</h2>
          <p class="case-cta-description">
            If you have an AI, automation or digital product challenge, let’s turn it into a clear and executable solution.
          </p>
          <a href="/contact" class="primary-button">Book a consultation <span aria-hidden="true">→</span></a>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-brand">
          <a href="/" class="logo" aria-label="Mariya Mihaylova homepage">
            MM
          </a>
          <p class="footer-tagline">AI Transformation &amp; Digital Delivery Consultant</p>
          <p class="footer-meta">
            <span class="footer-icon" set:html={icons.pin} />
            Paris area, France
          </p>
          <p class="footer-meta">
            <span class="footer-icon" set:html={icons.globe} />
            Available worldwide
          </p>
        </div>

        <div class="footer-column">
          <p class="footer-heading">Quick Links</p>
          <a href="/">Home</a>
          <a href="/expertise">Expertise</a>
          <a href="/projects">Projects</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
        </div>

        <div class="footer-column">
          <p class="footer-heading">Connect</p>
          <a href="mailto:mariya@mariyamihaylova.com" class="footer-link-icon">
            <span class="footer-icon" set:html={icons.mail} />
            mariya@mariyamihaylova.com
          </a>
          <p class="footer-link-icon">
            <span class="footer-icon" set:html={icons.pin} />
            Paris area, France
          </p>
        </div>
      </div>
    </footer>

    <style>
      :global(html) {
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        background:
          radial-gradient(circle at top, rgba(32, 113, 255, 0.2), transparent 32%),
          linear-gradient(180deg, #020d1e 0%, #07192f 100%);
        color: #f3f7ff;
        font-family: Inter, "Segoe UI", sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .logo {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border: 1px solid rgba(255, 255, 255, 0.3);
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.02);
        color: #ffffff;
        font-size: 18px;
        font-weight: 800;
        letter-spacing: -0.08em;
      }

      header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgba(3, 10, 20, 0.76);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: min(1220px, calc(100% - 48px));
        margin: 0 auto;
        padding: 18px 0;
      }

      .navigation {
        display: flex;
        align-items: center;
        gap: 28px;
        color: rgba(245, 247, 250, 0.72);
        font-size: 13px;
        font-weight: 500;
      }

      .navigation a {
        transition: color 180ms ease;
      }

      .navigation a:hover,
      .active-page,
      .active-language {
        color: #ffffff;
      }

      .language-switcher {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-left: 8px;
        color: rgba(245, 247, 250, 0.62);
        font-size: 12px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .case-study-page {
        min-height: 100vh;
      }

      .hero {
        padding: 54px 0 32px;
      }

      .hero-inner {
        display: grid;
        grid-template-columns: 0.9fr 1.1fr;
        width: min(1180px, calc(100% - 48px));
        gap: 48px;
        margin: 0 auto;
        align-items: center;
      }

      .hero-copy {
        width: 100%;
      }

      .label {
        display: inline-flex;
        align-items: center;
        margin: 0 0 18px;
        border: 1px solid rgba(69, 199, 255, 0.6);
        border-radius: 4px;
        color: #45c7ff;
        padding: 8px 10px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0;
        font-size: clamp(36px, 4vw, 66px);
        line-height: 0.98;
        letter-spacing: -0.05em;
      }

      .tagline {
        max-width: 520px;
        margin: 18px 0 0;
        color: rgba(245, 247, 250, 0.7);
        font-size: 15px;
        line-height: 1.6;
      }

      .meta-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 26px;
      }

      .meta-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.025);
        padding: 12px 12px;
      }

      .meta-icon {
        display: flex;
        width: 28px;
        height: 28px;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: rgba(69, 199, 255, 0.12);
        color: #45c7ff;
      }

      .meta-icon :global(svg) {
        width: 14px;
        height: 14px;
      }

      .meta-label {
        margin: 0 0 4px;
        color: rgba(245, 247, 250, 0.45);
        font-size: 9.5px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .meta-value {
        margin: 0;
        color: #f5f7fa;
        font-size: 12px;
        font-weight: 600;
        line-height: 1.35;
      }

      .buttons {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 28px;
        flex-wrap: wrap;
      }

      .primary-button,
      .secondary-button {
        display: inline-flex;
        min-height: 48px;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border-radius: 8px;
        padding: 0 22px;
        font-weight: 700;
        font-size: 14px;
        transition: transform 180ms ease;
      }

      .primary-button:hover,
      .secondary-button:hover {
        transform: translateY(-1px);
      }

      .primary-button {
        background: linear-gradient(135deg, #1d63ff, #46b8ff);
        color: white;
      }

      .secondary-button {
        border: 1px solid rgba(255, 255, 255, 0.18);
        color: #f5f7fa;
        background: rgba(255, 255, 255, 0.02);
      }

      .hero-visual {
        display: flex;
        justify-content: center;
      }

      .dashboard-shell {
        width: min(100%, 760px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 18px;
        background: rgba(7, 17, 30, 0.96);
        box-shadow: 0 35px 80px rgba(0, 0, 0, 0.35);
        overflow: hidden;
      }

      .dashboard-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(255, 255, 255, 0.02);
        padding: 12px 18px;
      }

      .topbar-left,
      .topbar-right {
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .window-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.26);
      }

      .window-dot:first-child { background: rgba(255, 255, 255, 0.28); }
      .window-dot:nth-child(2) { background: rgba(69, 199, 255, 0.7); }
      .window-dot:nth-child(3) { background: rgba(255, 255, 255, 0.2); }

      .topbar-right {
        color: rgba(245, 247, 250, 0.76);
        font-size: 12px;
        gap: 12px;
      }

      .topbar-pill {
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 999px;
        padding: 5px 10px;
        font-size: 10px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .dashboard-content {
        display: flex;
        min-height: 560px;
      }

      .dashboard-sidebar {
        width: 200px;
        border-right: 1px solid rgba(255, 255, 255, 0.06);
        background: rgba(14, 28, 44, 0.8);
        padding: 18px 14px;
      }

      .sidebar-group {
        margin: 0 0 12px;
        color: #45c7ff;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .dashboard-sidebar ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }

      .dashboard-sidebar li {
        border-radius: 8px;
        padding: 9px 10px;
        color: rgba(245, 247, 250, 0.7);
        font-size: 12px;
      }

      .dashboard-sidebar li.active {
        background: rgba(69, 199, 255, 0.12);
        color: #f5f7fa;
      }

      .dashboard-main {
        flex: 1;
        padding: 18px 18px 20px;
      }

      .kpi-row {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
      }

      .kpi-box {
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.03);
        padding: 12px 10px;
      }

      .kpi-label {
        display: block;
        margin-bottom: 8px;
        color: rgba(245, 247, 250, 0.54);
        font-size: 10px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .kpi-box strong {
        display: block;
        margin-bottom: 6px;
        font-size: 18px;
        letter-spacing: -0.04em;
      }

      .kpi-box small {
        color: #7ce7bf;
        font-size: 10px;
        font-weight: 700;
      }

      .main-panel-grid {
        display: grid;
        grid-template-columns: 1.55fr 0.85fr;
        gap: 14px;
        margin-top: 16px;
      }

      .panel {
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.03);
        padding: 14px 12px 12px;
      }

      .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
        color: rgba(245, 247, 250, 0.7);
        font-size: 11px;
        font-weight: 600;
      }

      .panel-chart svg {
        width: 100%;
        height: 160px;
      }

      .donut-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        padding-top: 4px;
      }

      .donut-chart {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 122px;
        height: 122px;
        border-radius: 50%;
        background: conic-gradient(#45c7ff 0 42.3%, rgba(255,255,255,0.08) 42.3% 62.3%, rgba(255,255,255,0.04) 62.3% 100%);
      }

      .donut-chart::before {
        position: absolute;
        inset: 16px;
        border-radius: 50%;
        background: rgba(8, 18, 30, 0.96);
        content: "";
      }

      .donut-chart span {
        position: relative;
        z-index: 1;
        font-size: 18px;
        font-weight: 700;
      }

      .bottom-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        margin-top: 16px;
      }

      .panel-table table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11px;
      }

      .panel-table td {
        padding: 7px 2px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        color: rgba(245, 247, 250, 0.7);
      }

      .panel-table td:last-child {
        text-align: right;
        color: #ffffff;
        font-weight: 700;
      }

      .challenge-solution {
        padding: 24px 0 70px;
      }

      .challenge-solution-inner {
        display: grid;
        grid-template-columns: 1fr 1fr;
        width: min(1180px, calc(100% - 48px));
        gap: 18px;
        margin: 0 auto;
      }

      .cs-card {
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.03);
        padding: 24px 22px;
      }

      .cs-label {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0 0 18px;
        color: #45c7ff;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .cs-label-icon {
        display: flex;
        width: 28px;
        height: 28px;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: rgba(69, 199, 255, 0.12);
      }

      .cs-label-icon :global(svg) {
        width: 15px;
        height: 15px;
      }

      .cs-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .cs-list li {
        position: relative;
        padding-left: 18px;
        color: rgba(245, 247, 250, 0.68);
        font-size: 13px;
        line-height: 1.55;
      }

      .cs-list li::before {
        position: absolute;
        top: 8px;
        left: 0;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #45c7ff;
        content: "";
      }

      .how-it-works,
      .key-features,
      .contribution-impact,
      .tech-stack,
      .case-cta {
        padding: 70px 0;
      }

      .how-it-works {
        background: rgba(5, 16, 28, 0.85);
      }

      .section-label {
        margin: 0 0 24px;
        color: #1d63ff;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .how-it-works-inner,
      .key-features-inner,
      .tech-stack-inner,
      .contribution-impact-inner {
        width: min(1180px, calc(100% - 48px));
        margin: 0 auto;
      }

      .steps-row {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 14px;
        max-width: 980px;
        margin: 0 auto;
      }

      .step-card {
        position: relative;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.03);
        padding: 18px 14px 16px;
        text-align: center;
      }

      .step-card:not(:last-child)::after {
        position: absolute;
        top: 34px;
        right: -18px;
        width: 22px;
        height: 1px;
        background-image: linear-gradient(to right, rgba(69, 199, 255, 0.7) 50%, transparent 50%);
        background-size: 8px 1px;
        content: "";
      }

      .step-icon {
        display: flex;
        width: 40px;
        height: 40px;
        align-items: center;
        justify-content: center;
        margin: 0 auto 12px;
        border-radius: 50%;
        background: rgba(69, 199, 255, 0.12);
        color: #45c7ff;
      }

      .step-icon :global(svg) {
        width: 18px;
        height: 18px;
      }

      .step-title {
        margin: 0 0 7px;
        font-size: 13px;
        font-weight: 700;
      }

      .step-description {
        margin: 0;
        color: rgba(245, 247, 250, 0.52);
        font-size: 11.5px;
        line-height: 1.5;
      }

      .features-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
      }

      .feature-card {
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.03);
        padding: 20px 18px;
      }

      .feature-icon {
        display: flex;
        width: 38px;
        height: 38px;
        align-items: center;
        justify-content: center;
        margin-bottom: 14px;
        border-radius: 10px;
        background: rgba(69, 199, 255, 0.12);
        color: #45c7ff;
      }

      .feature-icon :global(svg) {
        width: 18px;
        height: 18px;
      }

      .feature-title {
        margin: 0 0 8px;
        font-size: 14px;
        font-weight: 700;
      }

      .feature-description {
        margin: 0;
        color: rgba(245, 247, 250, 0.54);
        font-size: 12.5px;
        line-height: 1.55;
      }

      .contribution-impact {
        background: rgba(6, 20, 38, 0.9);
      }

      .contribution-impact-inner {
        display: grid;
        grid-template-columns: 0.9fr 1.1fr;
        gap: 18px;
      }

      .contribution-panel,
      .impact-panel {
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.03);
        padding: 22px 20px;
      }

      .contribution-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .contribution-list li {
        position: relative;
        padding-left: 18px;
        color: rgba(245, 247, 250, 0.66);
        font-size: 13px;
        line-height: 1.55;
      }

      .contribution-list li::before {
        position: absolute;
        top: 7px;
        left: 0;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #45c7ff;
        content: "";
      }

      .impact-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
      }

      .impact-card {
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.03);
        padding: 18px 16px;
      }

      .impact-value {
        margin: 0 0 8px;
        color: #45c7ff;
        font-size: 26px;
        font-weight: 800;
        letter-spacing: -0.04em;
      }

      .impact-title {
        margin: 0 0 8px;
        font-size: 13px;
        font-weight: 700;
      }

      .impact-description {
        margin: 0;
        color: rgba(245, 247, 250, 0.52);
        font-size: 11.5px;
        line-height: 1.5;
      }

      .tech-stack {
        background: rgba(10, 24, 48, 0.9);
      }

      .tech-stack-row {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
      }

      .tech-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.03);
        padding: 10px 14px;
        color: rgba(245, 247, 250, 0.76);
        font-size: 12.5px;
        font-weight: 600;
      }

      .tech-pill-icon {
        display: flex;
        color: #45c7ff;
      }

      .tech-pill-icon :global(svg) {
        width: 16px;
        height: 16px;
      }

      .case-cta {
        position: relative;
        background: linear-gradient(180deg, #061426, #0a1c38);
        text-align: center;
        overflow: hidden;
      }

      .case-cta::before {
        position: absolute;
        left: 50%;
        bottom: -60px;
        width: 70%;
        height: 200px;
        transform: translateX(-50%);
        border-radius: 50%;
        background: radial-gradient(ellipse, rgba(29, 99, 255, 0.35), transparent 70%);
        content: "";
        filter: blur(10px);
      }

      .case-cta-inner {
        position: relative;
        z-index: 1;
        display: flex;
        width: min(620px, calc(100% - 48px));
        flex-direction: column;
        align-items: center;
        margin: 0 auto;
      }

      .case-cta-inner h2 {
        margin: 0 0 12px;
        font-size: clamp(24px, 3vw, 32px);
        letter-spacing: -0.04em;
      }

      .case-cta-description {
        max-width: 500px;
        margin: 0 0 22px;
        color: rgba(245, 247, 250, 0.62);
        font-size: 15px;
        line-height: 1.6;
      }

      footer {
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        background: rgba(2, 10, 20, 0.9);
        padding: 36px 0 24px;
      }

      .footer-inner {
        display: grid;
        grid-template-columns: 1.2fr 1fr 1fr;
        width: min(1180px, calc(100% - 48px));
        gap: 30px;
        margin: 0 auto;
      }

      .footer-brand {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .footer-tagline {
        margin: 0;
        color: rgba(245, 247, 250, 0.8);
        font-size: 13px;
      }

      .footer-meta,
      .footer-link-icon {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        color: rgba(245, 247, 250, 0.7);
        font-size: 13px;
      }

      .footer-icon {
        display: inline-flex;
        width: 16px;
        height: 16px;
        color: #45c7ff;
      }

      .footer-icon :global(svg) {
        width: 14px;
        height: 14px;
      }

      .footer-column {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .footer-heading {
        margin: 0 0 6px;
        color: #45c7ff;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .footer-column a,
      .footer-column p {
        color: rgba(245, 247, 250, 0.7);
        font-size: 13px;
      }

      @media (max-width: 1100px) {
        .hero-inner,
        .challenge-solution-inner,
        .contribution-impact-inner {
          grid-template-columns: 1fr;
        }

        .dashboard-shell {
          max-width: 760px;
        }

        .steps-row {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      @media (max-width: 820px) {
        .navigation {
          gap: 14px;
          font-size: 11px;
        }

        .hero-inner {
          width: min(100% - 30px, 1180px);
        }

        .meta-grid,
        .kpi-row,
        .features-grid,
        .impact-grid,
        .bottom-grid,
        .footer-inner {
          grid-template-columns: 1fr 1fr;
        }

        .dashboard-content {
          display: block;
        }

        .dashboard-sidebar {
          width: 100%;
          border-right: none;
          border-bottom: 1px solid rgba(255,255,255,0.06);
        }

        .steps-row {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 640px) {
        nav {
          width: min(100% - 24px, 1180px);
          padding: 14px 0;
        }

        .navigation {
          flex-wrap: wrap;
          justify-content: flex-end;
        }

        .hero,
        .challenge-solution,
        .how-it-works,
        .key-features,
        .contribution-impact,
        .tech-stack,
        .case-cta {
          padding: 48px 0;
        }

        .hero-inner,
        .challenge-solution-inner,
        .how-it-works-inner,
        .key-features-inner,
        .contribution-impact-inner,
        .tech-stack-inner,
        .footer-inner {
          width: min(100% - 24px, 1180px);
        }

        .meta-grid,
        .kpi-row,
        .features-grid,
        .impact-grid,
        .bottom-grid,
        .footer-inner,
        .steps-row {
          grid-template-columns: 1fr;
        }

        .buttons {
          flex-direction: column;
          align-items: stretch;
        }

        .primary-button,
        .secondary-button {
          width: 100%;
        }

        .dashboard-main {
          padding: 14px 12px 16px;
        }

        .step-card::after {
          display: none;
        }
      }
    </style>
  </body>
</html>
