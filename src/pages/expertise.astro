---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="Expertise that turns AI ambition into business execution - AI strategy, automation, digital products and delivery leadership."
    />

    <title>{pageTitle}</title>
  </head>

  <body>
    <header>
      <nav>
        <a href="/" class="logo" aria-label="Mariya Mihaylova homepage">
          MM
        </a>

        <div class="navigation">
          <a href="/">Home</a>
          <a href="/expertise" class="active-page">Expertise</a>
          <a href="/projects">Projects</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>

          <div class="language-switcher" aria-label="Language selector">
            <a href="/" class="active-language">EN</a>
            <span>|</span>
            <a href="/fr">FR</a>
          </div>
        </div>
      </nav>
    </header>

    <main>
      <section class="expertise-hero">
        <div class="expertise-hero-inner">
          <div class="expertise-hero-copy">
            <p class="label">End-to-end Capabilities</p>

            <h1>
              Expertise that turns AI ambition into{" "}
              <span>business execution.</span>
            </h1>

            <p class="description">
              AI strategy, intelligent automation, digital products,
              delivery leadership and transformation-designed to
              create measurable impact.
            </p>

            <div class="buttons">
              <a href="#core-expertise" class="primary-button">
                Explore services
              </a>

              <a href="/contact" class="secondary-button">
                Book a consultation
              </a>
            </div>
          </div>

          <div class="expertise-hero-visual">
            <img
              src="/images/expertise_hero.png"
              alt="AI Support Copilot dashboard with automation, workflow and business impact metrics"
              class="expertise-hero-image"
            />
          </div>
        </div>
      </section>

      <div class="filters">
        <div class="filters-inner">
          {
            capabilityFilters.map((filter) => (
              <span class="filter-tab">
                <span class="filter-tab-icon" set:html={filter.icon} />
                {filter.label}
              </span>
            ))
          }
        </div>
      </div>

      <section id="core-expertise" class="core">
        <div class="core-inner">
          <p class="section-label">Core Expertise</p>
          <h2>End-to-end capabilities for real-world impact</h2>

          <div class="core-grid">
            {
              coreExpertise.map((card) => (
                <div class="core-card">
                  <div class="core-card-head">
                    <span class="core-card-icon" set:html={card.icon} />
                  </div>
                  <p class="core-card-title">{card.title}</p>
                  <p class="core-card-description">{card.description}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="practice">
        <div class="practice-inner">
          <p class="section-label">How I Work</p>
          <h2>What this looks like in practice</h2>

          <div class="practice-row">
            {
              practiceSteps.map((step) => (
                <div class="practice-step">
                  <div class="practice-step-number">{step.number}</div>
                  <span class="practice-step-icon" set:html={step.icon} />
                  <p class="practice-step-title">{step.title}</p>
                  <p class="practice-step-description">
                    {step.description}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="outcomes">
        <div class="outcomes-inner">
          <p class="section-label">Business Outcomes</p>
          <h2>Outcomes that matter</h2>

          <div class="outcomes-grid">
            {
              outcomes.map((outcome) => (
                <div class="outcome-card">
                  <span
                    class="outcome-card-icon"
                    set:html={outcome.icon}
                  />
                  <p class="outcome-card-title">{outcome.title}</p>
                  <p
                    class="outcome-card-description"
                    set:html={renderHighlighted(outcome.description)}
                  />
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="engagement">
        <div class="engagement-inner">
          <p class="section-label">Engagement Models</p>
          <h2>Ways to work with me</h2>

          <div class="engagement-grid">
            {
              engagementModels.map((model) => (
                <div class="engagement-card">
                  <span
                    class="engagement-card-icon"
                    set:html={model.icon}
                  />
                  <p class="engagement-card-title">{model.title}</p>
                  <p class="engagement-card-description">
                    {model.description}
                  </p>

                  <ul class="engagement-card-list">
                    {model.items.map((item) => <li>{item}</li>)}
                  </ul>

                  <a href="/contact" class="engagement-card-link">
                    Let's talk
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="industries">
        <div class="industries-inner">
          <p class="section-label">Industries & Contexts</p>

          <div class="industries-row">
            {
              industries.map((industry) => (
                <div class="industry-item">
                  <span
                    class="industry-icon"
                    set:html={industry.icon}
                  />
                  <p class="industry-label">{industry.label}</p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="tools">
        <div class="tools-inner">
          <p class="section-label">Selected Tools & Technologies</p>

          <div class="tools-row">
            {
              tools.map((tool) => (
                <div class="tool-pill">
                  <span class="tool-icon" set:html={tool.icon} />
                  {tool.label}
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="expertise-cta">
