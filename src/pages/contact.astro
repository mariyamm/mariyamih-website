---
const pageTitle = "Contact | Mariya Mihaylova";

// Get your free access key at https://web3forms.com by registering
// mariyamm@umich.edu, then paste it below. All form submissions will
// be emailed to whichever address is registered with this key.
const WEB3FORMS_ACCESS_KEY = "6d7a51e5-0a4e-48e9-bc86-8a7b671ec864";

const icons = {
  mail: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>',
  pin: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.4 7-11.5A7 7 0 0 0 5 9.5C5 14.6 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.3"/></svg>',
  clock:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>',
  calendar:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>',
  user: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.4"/><path d="M5 20c1.2-3.6 4-5.4 7-5.4s5.8 1.8 7 5.4"/></svg>',
  cube: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"/><path d="M12 3v18M4 7.5l8 4.5 8-4.5"/></svg>',
  chevron:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>',
};

const contactMethods = [
  {
    icon: icons.mail,
    label: "Email",
    lines: ["mariya@mariyamihaylova.com"],
  },
  {
    icon: icons.pin,
    label: "Location",
    lines: ["Paris, France", "Available worldwide"],
  },
  {
    icon: icons.clock,
    label: "Availability",
    lines: ["Monday – Friday", "9:00 AM – 6:00 PM CET"],
  },
  {
    icon: icons.calendar,
    label: "Book a call",
    lines: ["Schedule a 30-min discovery call"],
    link: {
      text: "Request a call",
      href: "mailto:mariya@mariyamihaylova.com?subject=Discovery%20call%20request",
    },
  },
];

const faqs = [
  {
    question: "What types of projects do you work on?",
    answer:
      "AI strategy and implementation, workflow automation, product and project delivery, enterprise IT transformation, e-commerce platforms, and internal AI tools and agents.",
  },
  {
    question: "How do we start working together?",
    answer:
      "Reach out via the form or email above with a short summary of your challenge. I'll follow up to schedule an intro call and outline next steps.",
  },
  {
    question: "Do you offer long-term partnerships?",
    answer:
      "Yes - beyond one-off projects, I also work with organizations on an ongoing basis to support delivery, roadmap execution and continuous improvement.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="Get in touch with Mariya Mihaylova for AI transformation, digital delivery and product consulting."
    />

    <title>{pageTitle}</title>
  </head>

  <body>
    <header>
      <nav>
        <a href="/" class="logo" aria-label="Mariya Mihaylova homepage">
          MM
        </a>

        <div class="navigation">
          <a href="/">Home</a>
          <a href="/expertise">Expertise</a>
          <a href="/projects">Projects</a>
          <a href="/about">About</a>
          <a href="/contact" class="active-page">Contact</a>

          <div class="language-switcher" aria-label="Language selector">
            <a href="/" class="active-language">EN</a>
            <span>|</span>
            <a href="/fr">FR</a>
          </div>
        </div>
      </nav>
    </header>

    <main>
      <section class="contact-hero">
        <div class="contact-hero-inner">
          <div class="contact-hero-copy">
            <p class="label">Contact</p>

            <h1>Let's connect</h1>

            <p class="description">
              Have a challenge to solve or an idea to build? I'd love
              to hear from you.
            </p>

            <span class="accent-rule" aria-hidden="true"></span>
          </div>

          <div class="contact-hero-visual" aria-hidden="true">
            <img
              src="/images/contact_1.png"
              alt=""
              class="hero-visual-image"
              loading="eager"
            />
          </div>
        </div>
      </section>

      <section class="conversation">
        <div class="conversation-card">
          <div class="conversation-info">
            <h2>Let's start a conversation</h2>

            <p class="conversation-intro">
              Whether you have a question, a project idea, or just
              want to say hello - I'll get back to you as soon as
              possible.
            </p>

            <div class="contact-methods">
              {
                contactMethods.map((method) => (
                  <div class="contact-method">
                    <span class="contact-method-icon" set:html={method.icon} />
                    <div>
                      <p class="contact-method-label">{method.label}</p>
                      {method.lines.map((line) => (
                        <p class="contact-method-line">{line}</p>
                      ))}
                      {method.link && (
                        <a
                          href={method.link.href}
                          class="contact-method-link"
                        >
                          {method.link.text}
                          <span aria-hidden="true">→</span>
                        </a>
                      )}
                    </div>
                  </div>
                ))
              }
            </div>

            <div class="conversation-footnote">
              <p class="conversation-footnote-title">
                Let's build something meaningful.
              </p>
              <p class="conversation-footnote-text">
                I'm excited to hear about your vision.
              </p>
            </div>
          </div>

          <div class="conversation-form">
            <h2>Send me a message</h2>
            <p class="form-subtitle">
              Fill out the form below and I'll get back to you within
              24-48 hours.
            </p>

            <form
              id="contact-form"
              action="https://api.web3forms.com/submit"
              method="POST"
            >
              <input
                type="hidden"
                name="access_key"
                value={WEB3FORMS_ACCESS_KEY}
              />
              <input
                type="checkbox"
                name="botcheck"
                class="botcheck"
                tabindex="-1"
                autocomplete="off"
              />
              <input
                type="hidden"
                name="from_name"
                value="Portfolio Contact Form"
              />

              <div class="form-row">
                <div class="form-field">
                  <label for="name">Your name*</label>
                  <input type="text" id="name" name="name" required />
                </div>

                <div class="form-field">
                  <label for="email">Your email*</label>
                  <input type="email" id="email" name="email" required />
                </div>
              </div>

              <div class="form-field">
                <label for="company">Company / Organization</label>
                <input type="text" id="company" name="company" />
              </div>

              <div class="form-field">
                <label for="subject">Subject*</label>
                <input
                  type="text"
                  id="subject"
                  name="subject"
                  placeholder="e.g. AI strategy, automation, partnership..."
                  required
                />
              </div>

              <div class="form-field">
                <label for="message">Your message*</label>
                <textarea
                  id="message"
                  name="message"
                  rows="6"
                  placeholder="Tell me about your project or challenge..."
                  required
                ></textarea>
              </div>

              <div class="form-actions">
                <button type="submit" class="primary-button form-submit">
                  <span class="form-submit-label">Send Message</span>
                  <span aria-hidden="true">→</span>
                </button>
              </div>

              <p class="form-status" role="status" aria-live="polite"></p>

              <p class="form-security">
                🔒 Your data is secure and will never be shared.
              </p>
            </form>
          </div>
        </div>
      </section>

      <section class="faq">
        <div class="faq-inner">
          <div class="faq-copy">
            <p class="section-label">FAQ</p>
            <h2>Frequently asked questions</h2>

            <div class="faq-list">
              {
                faqs.map((faq) => (
                  <details class="faq-item">
                    <summary>
                      <span>{faq.question}</span>
                      <span class="faq-chevron" set:html={icons.chevron} />
                    </summary>
                    <p class="faq-answer">{faq.answer}</p>
                  </details>
                ))
              }
            </div>

            <p class="faq-more">
              Still have questions? Feel free to{" "}
              <a href="mailto:mariya@mariyamihaylova.com">reach out</a>.
            </p>
          </div>

          <div class="orbit-globe" aria-hidden="true">
            <img
              src="/images/contact_2.png"
              alt=""
              class="globe-image"
              loading="lazy"
            />
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-brand">
          <a href="/" class="logo" aria-label="Mariya Mihaylova homepage">
            MM
          </a>
          <p class="footer-tagline">AI for innovation & Digital Change.</p>
          <a href="mailto:mariya@mariyamihaylova.com" class="footer-link-icon">
            <span class="footer-icon" set:html={icons.mail} />
            mariya@mariyamihaylova.com
          </a>
        </div>

        <div class="footer-column">
          <p class="footer-heading">Quick Links</p>
          <a href="/">Home</a>
          <a href="/expertise">Expertise</a>
          <a href="/projects">Projects</a>
          <a href="/about">About</a>
          <a href="/contact" class="footer-link-active">Contact</a>
        </div>

        <div class="footer-column">
          <p class="footer-heading">Expertise</p>
          <a href="/expertise">AI Strategy & Implementation</a>
          <a href="/expertise">Digital Transformation</a>
          <a href="/expertise">Products & Platforms</a>
          <a href="/expertise">Data & Analytics</a>
        </div>

        <div class="footer-column">
          <p class="footer-heading">Languages</p>
          <p class="footer-note">
            This website is available in English / Français.
          </p>
          <div class="footer-lang-links">
            <a href="/" class="active-language">En</a>
            <span>|</span>
            <a href="/fr">Fr</a>
          </div>
        </div>
      </div>

      <div class="footer-bottom">
        <p>© 2025 MM. All rights reserved.</p>
        <div class="footer-bottom-links">
          <a href="#">Privacy Policy</a>
          <a href="#">Terms of Use</a>
        </div>
      </div>
    </footer>

    <script>
      const form = document.getElementById(
        "contact-form",
      ) as HTMLFormElement | null;
      const status = form?.querySelector(".form-status") as HTMLElement | null;
      const submitButton = form?.querySelector(
        ".form-submit",
      ) as HTMLButtonElement | null;
      const submitLabel = form?.querySelector(
        ".form-submit-label",
      ) as HTMLElement | null;

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!status || !submitButton || !submitLabel) return;

        const accessKey = (
          form.elements.namedItem("access_key") as HTMLInputElement
        )?.value;

        if (!accessKey || accessKey === "YOUR_WEB3FORMS_ACCESS_KEY") {
          status.textContent =
            "Form isn't configured yet - please email me directly instead.";
          status.className = "form-status form-status-error";
          return;
        }

        submitButton.disabled = true;
        submitLabel.textContent = "Sending...";
        status.textContent = "";
        status.className = "form-status";

        try {
          const response = await fetch(form.action, {
            method: "POST",
            headers: { Accept: "application/json" },
            body: new FormData(form),
          });
          const result = await response.json();

          if (result.success) {
            status.textContent =
              "Thanks - your message has been sent. I'll be in touch soon.";
            status.className = "form-status form-status-success";
            form.reset();
          } else {
            throw new Error(result.message || "Submission failed");
          }
        } catch (error) {
          status.textContent =
            "Something went wrong. Please email me directly instead.";
          status.className = "form-status form-status-error";
        } finally {
          submitButton.disabled = false;
          submitLabel.textContent = "Send Message";
        }
      });
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #061426;
    color: #f5f7fa;
    font-family:
      Inter,
      Arial,
      Helvetica,
      sans-serif;
  }

  :global(img) {
    display: block;
    max-width: 100%;
  }

  header {
    position: relative;
    z-index: 20;
    width: 100%;
  }

  nav {
    display: flex;
    width: min(1180px, calc(100% - 48px));
    min-height: 88px;
    align-items: center;
    justify-content: space-between;
    margin: 0 auto;
  }

  .logo {
    color: #45c7ff;
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -4px;
    text-decoration: none;
    text-shadow: 0 0 20px rgba(69, 199, 255, 0.32);
  }

  .navigation {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  .navigation > a {
    position: relative;
    color: rgba(245, 247, 250, 0.78);
    font-size: 14px;
    text-decoration: none;
  }

  .navigation > a::after {
    position: absolute;
    right: 0;
    bottom: -9px;
    left: 0;
    height: 2px;
    background: #1d63ff;
    content: "";
    opacity: 0;
    transform: scaleX(0);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .navigation > a:hover {
    color: #ffffff;
  }

  .navigation > a:hover::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .navigation > a.active-page {
    color: #45c7ff;
  }

  .navigation > a.active-page::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .language-switcher {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: 10px;
    color: rgba(245, 247, 250, 0.38);
    font-size: 13px;
  }

  .language-switcher a {
    color: rgba(245, 247, 250, 0.62);
    text-decoration: none;
  }

  .language-switcher .active-language {
    color: #45c7ff;
  }

  .label {
    width: fit-content;
    margin: 0 0 26px;
    border: 1px solid rgba(69, 199, 255, 0.58);
    border-radius: 4px;
    color: #45c7ff;
    padding: 9px 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .section-label {
    margin: 0 0 16px;
    color: #1d63ff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .primary-button {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: none;
    border-radius: 5px;
    background: #1d63ff;
    box-shadow: 0 14px 32px rgba(29, 99, 255, 0.28);
    padding: 0 24px;
    color: white;
    font-family: inherit;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 180ms ease,
      background 180ms ease;
  }

  .primary-button:hover {
    background: #3476ff;
    transform: translateY(-2px);
  }

  .primary-button:disabled {
    cursor: not-allowed;
    opacity: 0.7;
    transform: none;
  }

  /* ---------- Contact hero ---------- */

  .contact-hero {
    position: relative;
    overflow: hidden;
  }

  .contact-hero-inner {
    display: grid;
    width: min(1180px, calc(100% - 48px));
    grid-template-columns: 1fr 0.85fr;
    align-items: center;
    gap: 40px;
    margin: 0 auto;
    padding: 50px 0 70px;
  }

  h1 {
    max-width: 560px;
    margin: 0;
    font-size: clamp(38px, 4.6vw, 54px);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .description {
    max-width: 460px;
    margin: 18px 0 0;
    color: rgba(245, 247, 250, 0.65);
    font-size: 16px;
    line-height: 1.65;
  }

  .accent-rule {
    display: block;
    width: 46px;
    height: 3px;
    margin-top: 26px;
    border-radius: 2px;
    background: #1d63ff;
  }

  .contact-hero-visual {
    position: relative;
    height: 320px;
  }

  .hero-visual-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    -webkit-mask-image: radial-gradient(
      circle at center,
      #000 35%,
      transparent 70%
    );
    mask-image: radial-gradient(circle at center, #000 35%, transparent 70%);
  }

  /* ---------- Conversation section ---------- */

  .conversation {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    padding-bottom: 100px;
  }

  .conversation-card {
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.02);
    overflow: hidden;
  }

  .conversation-card h2 {
    margin: 0 0 12px;
    font-size: 22px;
    letter-spacing: -0.01em;
  }

  .conversation-info {
    position: relative;
    padding: 40px;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
  }

  .conversation-intro {
    margin: 0 0 30px;
    color: rgba(245, 247, 250, 0.6);
    font-size: 14.5px;
    line-height: 1.65;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .contact-method {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .contact-method-icon {
    display: flex;
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #1d63ff;
    color: #ffffff;
  }

  .contact-method-icon :global(svg) {
    width: 17px;
    height: 17px;
  }

  .contact-method-label {
    margin: 2px 0 4px;
    font-size: 14.5px;
    font-weight: 700;
  }

  .contact-method-line {
    margin: 0;
    color: rgba(245, 247, 250, 0.6);
    font-size: 13.5px;
    line-height: 1.5;
  }

  .contact-method-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    color: #45c7ff;
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
  }

  .contact-method-link:hover {
    text-decoration: underline;
  }

  .conversation-footnote {
    position: relative;
    margin-top: 34px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .conversation-footnote::after {
    position: absolute;
    bottom: -1px;
    left: 0;
    width: 90px;
    height: 2px;
    background: linear-gradient(90deg, #45c7ff, transparent);
    content: "";
  }

  .conversation-footnote-title {
    margin: 0 0 4px;
    font-size: 14.5px;
    font-weight: 700;
  }

  .conversation-footnote-text {
    margin: 0;
    color: rgba(245, 247, 250, 0.55);
    font-size: 13.5px;
  }

  .conversation-form {
    padding: 40px;
  }

  .form-subtitle {
    margin: 0 0 26px;
    color: rgba(245, 247, 250, 0.55);
    font-size: 13.5px;
    line-height: 1.6;
  }

  .botcheck {
    position: absolute;
    left: -9999px;
    opacity: 0;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 16px;
  }

  .form-field label {
    color: rgba(245, 247, 250, 0.65);
    font-size: 13px;
    font-weight: 600;
  }

  .form-field input,
  .form-field textarea {
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
    padding: 12px 14px;
    color: #f5f7fa;
    font-family: inherit;
    font-size: 14px;
    resize: vertical;
    transition: border-color 180ms ease;
  }

  .form-field input:focus,
  .form-field textarea:focus {
    border-color: rgba(69, 199, 255, 0.6);
    outline: none;
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: rgba(245, 247, 250, 0.32);
  }

  .form-actions {
    margin-top: 8px;
  }

  .form-submit {
    width: 100%;
  }

  .form-status {
    min-height: 20px;
    margin: 14px 0 0;
    font-size: 13.5px;
  }

  .form-status-success {
    color: #45c7ff;
  }

  .form-status-error {
    color: #ff8080;
  }

  .form-security {
    margin: 10px 0 0;
    color: rgba(245, 247, 250, 0.4);
    font-size: 12.5px;
  }

  /* ---------- FAQ ---------- */

  .faq {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
    padding-bottom: 100px;
  }

  .faq-inner {
    display: grid;
    grid-template-columns: 1fr 0.75fr;
    align-items: center;
    gap: 60px;
  }

  .faq-copy h2 {
    margin: 0 0 30px;
    font-size: clamp(26px, 3vw, 32px);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-item {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.03);
    padding: 4px 20px;
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
    color: #f5f7fa;
    font-size: 14.5px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
