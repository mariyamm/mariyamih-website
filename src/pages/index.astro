---
const pageTitle = "Mariya Mihaylova | AI Transformation Consultant";

const companies = [
  {
    name: "Worldgrid",
    logo: "/images/worldgrid_logo.png",
    wide: true,
  },
  {
    name: "Atos",
    logo: "/images/atos_logo.png",
    wide: false,
  },
  {
    name: "Americaneagle.com",
    logo: "/images/americaneagle_logo.png",
    wide: true,
  },
  {
    name: "IFS",
    logo: "/images/ifs_logo.png",
    wide: false,
  },
  {
    name: "Shopify",
    logo: "/images/shopify_logo.png",
    wide: true,
  },
];

const icons = {
  brain:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4M5 5l3 3M16 16l3 3M19 5l-3 3M8 16l-3 3"/></svg>',
  transform:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 0 1 13.3-6M20 12a8 8 0 0 1-13.3 6"/><path d="M17 3v4h-4M7 21v-4h4"/></svg>',
  cube: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"/><path d="M12 3v18M4 7.5l8 4.5 8-4.5"/></svg>',
  chart:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>',
  target:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4.4"/><circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none"/></svg>',
  workflow:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="6" r="2"/><circle cx="5" cy="18" r="2"/><circle cx="19" cy="12" r="2"/><path d="M7 6h6a4 4 0 0 1 4 4M7 18h6a4 4 0 0 0 4-4"/></svg>',
  checklist:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>',
  building:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21h16M5 21V10M19 21V10M3 10l9-6 9 6M9 21v-7M15 21v-7"/></svg>',
  cart: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.4" fill="currentColor" stroke="none"/><circle cx="18" cy="20" r="1.4" fill="currentColor" stroke="none"/><path d="M2 3h3l2.4 12.2a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L21 8H6"/></svg>',
  robot:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="8" width="14" height="10" rx="2"/><path d="M12 8V4M9 4h6"/><circle cx="9" cy="13" r="1.2" fill="currentColor" stroke="none"/><circle cx="15" cy="13" r="1.2" fill="currentColor" stroke="none"/><path d="M9 16.5h6"/></svg>',
  search:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.3-4.3"/></svg>',
  list: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6h11M9 12h11M9 18h11"/><circle cx="4.5" cy="6" r="1.3" fill="currentColor" stroke="none"/><circle cx="4.5" cy="12" r="1.3" fill="currentColor" stroke="none"/><circle cx="4.5" cy="18" r="1.3" fill="currentColor" stroke="none"/></svg>',
  rocket:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2c3 2 5 6 5 10 0 2-1 4-2 5l-3 3-3-3c-1-1-2-3-2-5 0-4 2-8 5-10z"/><circle cx="12" cy="10" r="1.6" fill="currentColor" stroke="none"/><path d="M8.5 16 6 21l3-1.5M15.5 16 18 21l-3-1.5"/></svg>',
  trendUp:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8"/><path d="M15 6h6v6"/></svg>',
  mail: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>',
  pin: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.4 7-11.5A7 7 0 0 0 5 9.5C5 14.6 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.3"/></svg>',
  globe:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>',
};

const aboutCards = [
  {
    title: "AI & Automation",
    description:
      "Implementing intelligent solutions that save time and drive growth.",
    icon: icons.brain,
  },
  {
    title: "Digital Transformation",
    description:
      "Improving processes, systems and collaboration across organizations.",
    icon: icons.transform,
  },
  {
    title: "Product & Delivery",
    description:
      "From strategy and roadmap to delivery and continuous improvement.",
    icon: icons.cube,
  },
  {
    title: "Data & Insights",
    description:
      "Turning data into actionable insights and clear business decisions.",
    icon: icons.chart,
  },
];

const expertiseCards = [
  {
    title: "AI Strategy & Implementation",
    description:
      "Define AI opportunities, build business cases and implement solutions that deliver measurable ROI.",
    icon: icons.target,
  },
  {
    title: "Workflow Automation",
    description:
      "Automate processes and integrate systems to increase productivity and accuracy.",
    icon: icons.workflow,
  },
  {
    title: "Product & Project Delivery",
    description:
      "Lead projects from discovery to launch with a focus on value, quality and on-time delivery.",
    icon: icons.checklist,
  },
  {
    title: "Enterprise IT Transformation",
    description:
      "Modernize systems and architecture to build scalable, secure and future-ready organizations.",
    icon: icons.building,
  },
  {
    title: "E-commerce & Digital Platforms",
    description:
      "Design and optimize e-commerce experiences, integrations and digital platforms that drive growth.",
    icon: icons.cart,
  },
  {
    title: "AI Agents & Internal Tools",
    description:
      "Build internal AI tools and agents that empower teams and improve decision-making.",
    icon: icons.robot,
  },
];

const projects = [
  {
    title: "AstroNova",
    description:
      "AI-powered platform that generates detailed, personalized astrology reports from astrology chart data.",
    tags: ["OpenAI", "Next.js", "Python", "PostgreSQL"],
    tone: "light",
    thumb: "/images/astronova.png",
    href: "/projects/astronova",
  },
  {
    title: "AI Support Copilot for E-commerce",
    description:
      "AI assistant that automates customer support, summarizes conversations and suggests actions in real-time.",
    tags: ["OpenAI", "LangChain", "Python", "Shopify"],
    tone: "light",
    thumb: "/images/project1.png",
    href: "/projects/ai-support-copilot",
  },
  {
    title: "MAIA",
    description:
      "A secure AI assistant that helps teams search, analyze and synthesize internal documentation faster.",
    tags: ["OpenAI", "LangChain", "Python", "pgvector"],
    tone: "dark",
    thumb: "/images/MAIA_header_image.png",
    href: "/projects/maia",
  },
  {
    title: "E-commerce Intelligence Dashboard",
    description:
      "A real-time analytics dashboard connecting sales, customer, and operational data to support faster decisions.",
    tags: ["Analytics", "E-commerce", "SQL", "Python"],
    tone: "dark",
    thumb: "/images/MAIA_header_image.png",
    href: "/projects/e-commerce-intelligence-dashboard",
  },
];

const processSteps = [
  {
    number: "1",
    title: "Discover",
    description:
      "Understand your business, challenges and opportunities through deep collaboration.",
    icon: icons.search,
  },
  {
    number: "2",
    title: "Prioritize",
    description:
      "Define the right problems to solve and build a clear roadmap for impact.",
    icon: icons.list,
  },
  {
    number: "3",
    title: "Build",
    description:
      "Design and implement solutions with agility, quality and transparency.",
    icon: icons.rocket,
  },
  {
    number: "4",
    title: "Scale",
    description:
      "Measure outcomes, optimize and scale solutions across your organization.",
    icon: icons.trendUp,
  },
];

const experience = [
  {
    period: "January 2026 - Present",
    role: "AI Consultant & Digital Project Manager",
    description: "Freelance advisory and delivery of AI and digital projects.",
    company: "Freelance",
    location: "Paris, France",
    logo: "/images/worldgrid_logo.png",
  },
  {
    period: "January 2025 - January 2026",
    role: "AI Project Manager",
    description:
      "Co-led internal AI solutions, including a secure RAG-based assistant.",
    company: "Alten Worldgrid",
    location: "Paris, France",
    logo: "/images/worldgrid_logo.png",
  },
  {
    period: "September 2022 - December 2024",
    role: "Technical-Functional Consultant / IT Project Manager",
    description:
      "Managed international projects and system implementations.",
    company: "Atos Worldgrid",
    location: "Paris, France",
    logo: "/images/atos_logo.png",
  },
  {
    period: "January 2020 - August 2022",
    role: "E-commerce Project Manager",
    description: "Led e-commerce platform projects and optimizations.",
    company: "Americaneagle.com",
    location: "Chicago, USA",
    logo: "/images/americaneagle_logo.png",
  },
  {
    period: "January 2018 - December 2019",
    role: "Product Manager",
    description: "Managed product roadmap, features and stakeholder alignment.",
    company: "Melistics",
    location: "Chicago, USA",
    logo: "/images/melistics_logo.png",
  },
];

const tools = [
  "OpenAI API",
  "LangChain",
  "Flowise",
  "Make",
  "Python",
  "SQL",
  "REST APIs",
  "Shopify",
  "WordPress",
  "Django",
  "Jira",
  "Confluence",
  "Notion",
  "...and more",
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <meta
      name="description"
      content="AI transformation, digital delivery and product consulting."
    />

    <title>{pageTitle}</title>
  </head>

  <body>
    <header>
      <nav>
        <a href="/" class="logo" aria-label="Mariya Mihaylova homepage">
          MM
        </a>

        <div class="navigation">
          <a href="/" class="active-page">Home</a>
          <a href="/expertise">Expertise</a>
          <a href="/projects">Projects</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>

          <div class="language-switcher" aria-label="Language selector">
            <a href="/" class="active-language">EN</a>
            <span>|</span>
            <a href="/fr">FR</a>
          </div>
        </div>
      </nav>
    </header>

    <main>
      <section class="hero">
        <div class="hero-content">
          <p class="label">
            AI Transformation & Digital Delivery
          </p>

          <h1>
            Turning business challenges into practical{" "}
            <span>AI and digital solutions.</span>
          </h1>

          <p class="description">
            I help organizations design, implement and scale AI,
            automation and digital products that create measurable
            business impact.
          </p>

          <div class="buttons">
            <a href="/projects" class="primary-button">
              View my projects
              <span aria-hidden="true">→</span>
            </a>

            <a href="/contact" class="secondary-button">
              Work with me
            </a>
          </div>
        </div>

        <div class="hero-visual">
          <div class="network network-one"></div>
          <div class="network network-two"></div>

          <div class="hero-image-frame">
            <img
              src="/images/mariya-portfolio-4.png"
              alt="Mariya Mihaylova"
              class="hero-image"
            />
          </div>
        </div>
      </section>

      <section
        class="logo-ribbon"
        aria-label="Companies and platforms I have worked with"
      >
        <div class="logo-ribbon-inner">
          <p class="logo-ribbon-label">
            Trusted by & experienced with
          </p>

          <div class="logo-ribbon-logos">
            {
              companies.map((company) => (
                <div
                  class:list={[
                    "company-logo-shell",
                    company.wide && "company-logo-shell-wide",
                  ]}
                >
                  <img
                    src={company.logo}
                    alt={company.name}
                    class="company-logo"
                  />
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section id="about" class="about">
        <div class="about-inner">
          <div class="about-copy">
            <p class="section-label">About Me</p>

            <h2>Bridging business, technology and AI.</h2>

            <p class="about-paragraph">
              With a background in computer engineering and economics,
              I've worked across Europe and the United States on
              complex digital challenges at the intersection of
              business and technology.
            </p>

            <p class="about-paragraph">
              I help organizations design and implement AI, automation
              and digital solutions that streamline operations,
              customer experience and unlock new growth opportunities.
            </p>

            <p class="about-paragraph">
              Today, I focus on AI implementation, digital products,
              automation and org. transformation that deliver
              measurable and sustainable business impact.
            </p>
          </div>

          <div class="about-grid">
            {
              aboutCards.map((card) => (
                <div class="about-card">
                  <span class="about-card-icon" set:html={card.icon} />
                  <p class="about-card-title">{card.title}</p>
                  <p class="about-card-description">
                    {card.description}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section id="expertise" class="expertise">
        <div class="expertise-inner">
          <p class="section-label">How I Help</p>

          <h2>Solutions that drive impact</h2>

          <div class="expertise-grid">
            {
              expertiseCards.map((card) => (
                <div class="expertise-card">
                  <span class="expertise-card-icon" set:html={card.icon} />
                  <p class="expertise-card-title">{card.title}</p>
                  <p class="expertise-card-description">
                    {card.description}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section id="projects" class="projects">
        <div class="projects-inner">
          <p class="section-label">Selected Projects</p>

          <h2 class="dark-heading">Recent work, real impact</h2>

          <div class="projects-grid">
            {
              projects.map((project) => {
                const CardTag = project.href ? "a" : "div";
                return (
                  <CardTag
                    class="project-card"
                    {...(project.href ? { href: project.href } : {})}
                  >
                    {project.thumb ? (
                      <div class="project-thumb project-thumb-image-shell">
                        <img
                          src={project.thumb}
                          alt={project.title}
                          class="project-thumb-image"
                        />
                      </div>
                    ) : (
                      <div
                        class:list={[
                          "project-thumb",
                          `project-thumb-${project.tone}`,
                        ]}
                        aria-hidden="true"
                      >
                        <span class="project-thumb-dot" />
                        <span class="project-thumb-dot" />
                        <span class="project-thumb-dot" />
                        <div class="project-thumb-body">
                          <div class="project-thumb-line" />
                          <div class="project-thumb-line" />
                          <div class="project-thumb-line short" />
                        </div>
                      </div>
                    )}

                    <p class="project-title">{project.title}</p>
                    <p class="project-description">
                      {project.description}
                    </p>

                    <div class="project-tags">
                      {
                        project.tags.map((tag) => (
                          <span class="project-tag">{tag}</span>
                        ))
                      }
                    </div>
                  </CardTag>
                );
              })
            }
          </div>
        </div>
      </section>

      <section class="process">
        <div class="process-inner">
          <p class="section-label">How I Work</p>

          <h2>A structured approach to meaningful results</h2>

          <div class="process-grid">
            {
              processSteps.map((step) => (
                <div class="process-step">
                  <div class="process-step-number">{step.number}</div>
                  <span class="process-step-icon" set:html={step.icon} />
                  <p class="process-step-title">{step.title}</p>
                  <p class="process-step-description">
                    {step.description}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="experience">
        <div class="experience-inner">
          <p class="section-label">Experience</p>

          <h2>A track record across companies and markets</h2>

          <div class="experience-list">
            {
              experience.map((role) => (
                <div class="experience-row">
                  <div class="experience-period">
                    <span class="experience-dot" />
                    {role.period}
                  </div>

                  <div class="experience-role">
                    <p class="experience-role-title">{role.role}</p>
                    <p class="experience-role-description">
                      {role.description}
                    </p>
                  </div>

                  <div class="experience-company">
                    {
                      role.logo && (
                        <img
                          src={role.logo}
                          alt={role.company}
                          class="experience-company-logo"
                        />
                      )
                    }
                    <div>
                      <p class="experience-company-name">
                        {role.company}
                      </p>
                      <p class="experience-company-location">
                        {role.location}
                      </p>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section class="tools">
        <div class="tools-inner">
          <p class="section-label">Tools & Technologies</p>

          <h2 class="dark-heading">
            Tools I rely on to build modern solutions
          </h2>

          <div class="tools-grid">
            {
              tools.map((tool) => (
                <span class="tool-chip">{tool}</span>
              ))
            }
          </div>
        </div>
      </section>

      <section class="cta">
        <div class="cta-inner">
          <h2>Let's build something useful.</h2>

          <p class="cta-description">
            If you have an AI, automation or digital product challenge,
            let's turn it into a clear and executable solution.
          </p>

          <a href="/contact" class="primary-button">
            Book a consultation
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-brand">
          <a href="/" class="logo" aria-label="Mariya Mihaylova homepage">
            MM
          </a>
          <p class="footer-tagline">
            AI Transformation & Digital Delivery Consultant
          </p>
          <p class="footer-meta">
            <span class="footer-icon" set:html={icons.pin} />
            Paris area, France
          </p>
          <p class="footer-meta">
            <span class="footer-icon" set:html={icons.globe} />
            Available worldwide
          </p>
        </div>

        <div class="footer-column">
          <p class="footer-heading">Quick Links</p>
          <a href="/">Home</a>
          <a href="/expertise">Expertise</a>
          <a href="/projects">Projects</a>
          <a href="/about">About</a>
          <a href="/contact">Contact</a>
        </div>

        <div class="footer-column">
          <p class="footer-heading">Connect</p>
          <a href="mailto:mariya@mariyamihaylova.com" class="footer-link-icon">
            <span class="footer-icon" set:html={icons.mail} />
            mariya@mariyamihaylova.com
          </a>
          <p class="footer-link-icon">
            <span class="footer-icon" set:html={icons.pin} />
            Paris area, France
          </p>
        </div>

        <div class="footer-column">
          <p class="footer-heading">Languages</p>
          <p class="footer-note">
            This website is available in English / Français.
          </p>
        </div>
      </div>

      <div class="footer-bottom">
        <p>© 2024 Mariya Mihaylova. All rights reserved.</p>
        <div class="footer-bottom-links">
          <a href="#">Privacy Policy</a>
          <a href="#">Terms of Use</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #061426;
    color: #f5f7fa;
    font-family:
      Inter,
      Arial,
      Helvetica,
      sans-serif;
  }

  :global(img) {
    display: block;
    max-width: 100%;
  }

  header {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 20;
    width: 100%;
  }

  nav {
    display: flex;
    width: min(1180px, calc(100% - 48px));
    min-height: 88px;
    align-items: center;
    justify-content: space-between;
    margin: 0 auto;
  }

  .logo {
    color: #45c7ff;
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -4px;
    text-decoration: none;
    text-shadow: 0 0 20px rgba(69, 199, 255, 0.32);
  }

  .navigation {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  .navigation > a {
    position: relative;
    color: rgba(245, 247, 250, 0.78);
    font-size: 14px;
    text-decoration: none;
  }

  .navigation > a::after {
    position: absolute;
    right: 0;
    bottom: -9px;
    left: 0;
    height: 2px;
    background: #1d63ff;
    content: "";
    opacity: 0;
    transform: scaleX(0);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .navigation > a:hover {
    color: #ffffff;
  }

  .navigation > a:hover::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .language-switcher {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: 10px;
    color: rgba(245, 247, 250, 0.38);
    font-size: 13px;
  }

  .language-switcher a {
    color: rgba(245, 247, 250, 0.62);
    text-decoration: none;
  }

  .language-switcher .active-language {
    color: #45c7ff;
  }

  .hero {
    position: relative;
    display: grid;
    width: min(1180px, calc(100% - 48px));
    min-height: calc(100vh - 120px);
    grid-template-columns: 1.08fr 0.92fr;
    align-items: center;
    gap: 40px;
    margin: 0 auto;
    padding-top: 110px;
    overflow: hidden;
  }

  .hero::before {
    position: absolute;
    top: 4%;
    right: -10%;
    width: 700px;
    height: 700px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(29, 99, 255, 0.17),
      rgba(29, 99, 255, 0.04) 45%,
      transparent 70%
    );
    content: "";
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 5;
    
	
  }

  .label {
    width: fit-content;
    margin: 0 0 26px;
    border: 1px solid rgba(69, 199, 255, 0.58);
    border-radius: 4px;
    color: #45c7ff;
    padding: 9px 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 690px;
    margin: 0;
    font-size: clamp(48px, 5.7vw, 78px);
    line-height: 1.02;
    letter-spacing: -0.052em;
  }

  h1 span {
    color: #45c7ff;
  }

  .description {
    max-width: 600px;
    margin: 28px 0 0;
    color: rgba(245, 247, 250, 0.7);
    font-size: 18px;
    line-height: 1.65;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 36px;
  }

  .buttons a {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: 5px;
    padding: 0 24px;
    font-weight: 700;
    text-decoration: none;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background 180ms ease;
  }

  .buttons a:hover {
    transform: translateY(-2px);
  }

  .primary-button {
    background: #1d63ff;
    color: white;
    box-shadow: 0 14px 32px rgba(29, 99, 255, 0.28);
  }

  .primary-button:hover {
    background: #3476ff;
  }

  .secondary-button {
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: white;
  }

  .secondary-button:hover {
    border-color: rgba(69, 199, 255, 0.7);
  }

  .hero-visual {
    position: relative;
    display: flex;
    height: 650px;
    align-self: end;
    align-items: flex-end;
    justify-content: center;
  }

  .hero-visual::before {
    position: absolute;
    right: 5%;
    bottom: 5%;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(29, 99, 255, 0.26),
      transparent 68%
    );
    content: "";
    filter: blur(15px);
  }

  .network {
    position: absolute;
    border: 1px solid rgba(69, 199, 255, 0.16);
    border-radius: 50%;
    opacity: 0.7;
  }

  .network::before,
  .network::after {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #45c7ff;
    box-shadow: 0 0 14px rgba(69, 199, 255, 0.85);
    content: "";
  }

  .network-one {
    top: 120px;
    right: 0;
    width: 430px;
    height: 250px;
    transform: rotate(-14deg);
  }

  .network-one::before {
    top: 30px;
    left: 70px;
  }

  .network-one::after {
    right: 55px;
    bottom: 40px;
  }

  .network-two {
    top: 230px;
    right: 80px;
    width: 330px;
    height: 190px;
    transform: rotate(17deg);
  }

  .network-two::before {
    top: 65px;
    right: 55px;
  }

  .network-two::after {
    bottom: 20px;
    left: 95px;
  }

  .hero-image-frame {
    position: relative;
    z-index: 3;
    width: 490px;
    max-width: 100%;
    aspect-ratio: 708 / 980;
    transform: translateY(-58px);
    overflow: visible;
  }

  .hero-image-frame::before {
    position: absolute;
    top: 10%;
    left: 50%;
    z-index: -1;
    width: 115%;
    height: 62%;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(29, 99, 255, 0.32),
      rgba(29, 99, 255, 0.1) 55%,
      transparent 75%
    );
    content: "";
    filter: blur(55px);
    pointer-events: none;
  }

  .hero-image {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    -webkit-mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 83%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      #000 0%,
      #000 83%,
      transparent 100%
    );
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    filter: drop-shadow(0 30px 40px rgba(2, 8, 20, 0.4));
  }

  .logo-ribbon {
    position: relative;
    z-index: 10;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: #0b1f3d;
  }

  .logo-ribbon-inner {
    display: flex;
    width: min(1180px, calc(100% - 48px));
    min-height: 148px;
    align-items: center;
    gap: 50px;
    margin: 0 auto;
    padding: 22px 0;
  }

  .logo-ribbon-label {
    flex: 0 0 185px;
    margin: 0;
    color: rgba(245, 247, 250, 0.45);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.13em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .logo-ribbon-logos {
    display: flex;
    flex: 1;
    align-items: center;
    flex-wrap: nowrap;
    justify-content: space-between;
    gap: 14px;
    min-width: 0;
  }

  .company-logo-shell {
    display: flex;
    width: 136px;
    height: 58px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .company-logo-shell-wide {
    width: 176px;
    height: 62px;
  }

  .company-logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0.62;
    transform: scale(1.72);
    transform-origin: center;
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }

  .company-logo:hover {
    opacity: 0.96;
    transform: scale(1.68) translateY(-1px);
  }

  @media (max-width: 950px) {
    .hero {
      grid-template-columns: 1fr 0.8fr;
    }

    .hero-image-frame {
      width: 410px;
    }

    .logo-ribbon-inner {
      gap: 30px;
    }

    .logo-ribbon-logos {
      gap: 10px;
    }

    .company-logo-shell {
      width: 140px;
      height: 50px;
    }

    .company-logo-shell-wide {
      width: 174px;
      height: 74px;
    }
  }

  @media (max-width: 760px) {
    nav {
      width: min(100% - 30px, 1180px);
    }

    .navigation > a {
      display: none;
    }

    .hero {
      width: min(100% - 30px, 1180px);
      min-height: auto;
      grid-template-columns: 1fr;
      padding-top: 120px;
    }

    .hero-content {
      padding-bottom: 25px;
    }

    h1 {
      font-size: clamp(46px, 14vw, 68px);
    }

    .description {
      font-size: 17px;
    }

    .hero-visual {
      height: 500px;
    }

    .hero-image-frame {
      width: 385px;
    }

    .network-one {
      right: -70px;
    }

    .network-two {
      right: 10px;
    }

    .logo-ribbon-inner {
      width: min(100% - 30px, 1180px);
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      padding: 30px 0;
    }

    .logo-ribbon-label {
      flex-basis: auto;
    }

    .logo-ribbon-logos {
      width: 100%;
      flex-wrap: nowrap;
      justify-content: flex-start;
      gap: 9px;
      overflow-x: auto;
      padding-bottom: 8px;
      scrollbar-width: none;
    }

    .logo-ribbon-logos::-webkit-scrollbar {
      display: none;
    }

    .company-logo-shell {
      width: 124px;
      height: 50px;
    }

    .company-logo-shell-wide {
      width: 156px;
      height: 54px;
    }
  }

  @media (max-width: 480px) {
    .buttons {
      flex-direction: column;
    }

    .buttons a {
      width: 100%;
    }

    .hero-visual {
      height: 430px;
    }

    .hero-image-frame {
      width: 341px;
    }
  }

  /* ---------- Shared section styles ---------- */

  .navigation > a.active-page {
    color: #ffffff;
  }

  .navigation > a.active-page::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .section-label {
    margin: 0 0 16px;
    color: #1d63ff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  main section h2 {
    max-width: 640px;
    margin: 0 0 20px;
    font-size: clamp(28px, 3.2vw, 38px);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .dark-heading {
    color: #0b1220;
  }

  /* ---------- About ---------- */

  .about {
    background: #f6f8fb;
    color: #0b1220;
    padding: 110px 0;
  }

  .about-inner {
    display: grid;
    width: min(1180px, calc(100% - 48px));
    grid-template-columns: 1fr 0.92fr;
    gap: 70px;
    margin: 0 auto;
    align-items: start;
  }

  .about-copy h2 {
    color: #0b1220;
  }

  .about-paragraph {
    margin: 0 0 18px;
    color: rgba(11, 18, 32, 0.64);
    font-size: 16px;
    line-height: 1.7;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .about-card {
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 12px;
    background: #ffffff;
    padding: 24px;
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.04);
  }

  .about-card-icon {
    display: flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    border-radius: 10px;
    background: rgba(29, 99, 255, 0.1);
    color: #1d63ff;
  }

  .about-card-icon :global(svg) {
    width: 20px;
    height: 20px;
  }

  .about-card-title {
    margin: 0 0 8px;
    font-size: 15px;
    font-weight: 700;
  }

  .about-card-description {
    margin: 0;
    color: rgba(11, 18, 32, 0.58);
    font-size: 13.5px;
    line-height: 1.55;
  }

  /* ---------- Expertise / How I Help ---------- */

  .expertise {
    background: #061426;
    padding: 110px 0;
  }

  .expertise-inner {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .expertise-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 46px;
  }

  .expertise-card {
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.03);
    padding: 28px 26px;
    transition: border-color 180ms ease, background 180ms ease;
  }

  .expertise-card:hover {
    border-color: rgba(69, 199, 255, 0.35);
    background: rgba(255, 255, 255, 0.05);
  }

  .expertise-card-icon {
    display: flex;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
    border-radius: 10px;
    background: rgba(69, 199, 255, 0.12);
    color: #45c7ff;
  }

  .expertise-card-icon :global(svg) {
    width: 22px;
    height: 22px;
  }

  .expertise-card-title {
    margin: 0 0 10px;
    font-size: 16px;
    font-weight: 700;
  }

  .expertise-card-description {
    margin: 0;
    color: rgba(245, 247, 250, 0.6);
    font-size: 14px;
    line-height: 1.6;
  }

  /* ---------- Projects ---------- */

  .projects {
    background: #f6f8fb;
    padding: 110px 0;
  }

  .projects-inner {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 46px;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 14px;
    background: #ffffff;
    overflow: hidden;
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.05);
    text-decoration: none;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  a.project-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(15, 23, 42, 0.1);
  }

  .project-thumb {
    position: relative;
    height: 130px;
    padding: 14px;
  }

  .project-thumb-image-shell {
    padding: 0;
    overflow: hidden;
  }

  .project-thumb-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .project-thumb-light {
    background: #eef2f8;
  }

  .project-thumb-dark {
    background: #0b1f3d;
  }

  .project-thumb-chart {
    background: linear-gradient(135deg, #0b1f3d, #123a72);
  }

  .project-thumb-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 5px;
    border-radius: 50%;
    background: rgba(69, 199, 255, 0.5);
  }

  .project-thumb-body {
    margin-top: 16px;
  }

  .project-thumb-line {
    height: 7px;
    margin-bottom: 8px;
    border-radius: 4px;
    background: rgba(69, 199, 255, 0.25);
  }

  .project-thumb-light .project-thumb-line {
    background: rgba(11, 18, 32, 0.1);
  }

  .project-thumb-line.short {
    width: 55%;
  }

  .project-title {
    margin: 20px 20px 0;
    color: #0b1220;
    font-size: 15px;
    font-weight: 700;
  }

  .project-description {
    margin: 8px 20px 0;
    color: rgba(11, 18, 32, 0.58);
    font-size: 13px;
    line-height: 1.6;
    flex-grow: 1;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 16px 20px 20px;
  }

  .project-tag {
    border-radius: 999px;
    background: rgba(29, 99, 255, 0.08);
    padding: 4px 10px;
    color: #1d63ff;
    font-size: 11px;
    font-weight: 600;
  }

  /* ---------- Process / How I Work ---------- */

  .process {
    background: #061426;
    padding: 110px 0 90px;
  }

  .process-inner {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 26px;
    margin-top: 46px;
  }

  .process-step {
    position: relative;
    padding-top: 8px;
  }

  .process-step-number {
    display: flex;
    width: 34px;
    height: 34px;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
    border-radius: 50%;
    background: #1d63ff;
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
  }

  .process-step-icon {
    display: none;
  }

  .process-step-title {
    margin: 0 0 8px;
    font-size: 17px;
    font-weight: 700;
  }

  .process-step-description {
    margin: 0;
    color: rgba(245, 247, 250, 0.6);
    font-size: 14px;
    line-height: 1.6;
  }

  /* ---------- Experience ---------- */

  .experience {
    background: #061426;
    padding: 20px 0 110px;
  }

  .experience-inner {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .experience-list {
    margin-top: 46px;
  }

  .experience-row {
    display: grid;
    grid-template-columns: 190px 1fr 220px;
    gap: 30px;
    align-items: center;
    padding: 22px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .experience-row:first-child {
    padding-top: 0;
  }

  .experience-row:last-child {
    border-bottom: none;
  }

  .experience-period {
    position: relative;
    padding-left: 22px;
    border-left: 2px solid rgba(69, 199, 255, 0.22);
    color: rgba(245, 247, 250, 0.55);
    font-size: 13px;
    font-weight: 600;
  }

  .experience-dot {
    position: absolute;
    top: 2px;
    left: -7px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #061426;
    border: 2px solid #45c7ff;
  }

  .experience-role-title {
    margin: 0 0 6px;
    font-size: 16px;
    font-weight: 700;
  }

  .experience-role-description {
    margin: 0;
    color: rgba(245, 247, 250, 0.58);
    font-size: 13.5px;
    line-height: 1.55;
  }

  .experience-company {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .experience-company-logo {
    width: 34px;
    height: 34px;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.85;
  }

  .experience-company-name {
    margin: 0;
    font-size: 13.5px;
    font-weight: 700;
  }

  .experience-company-location {
    margin: 2px 0 0;
    color: rgba(245, 247, 250, 0.5);
    font-size: 12.5px;
  }

  /* ---------- Tools & Technologies ---------- */

  .tools {
    background: #f6f8fb;
    padding: 110px 0;
  }

  .tools-inner {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .tools-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 46px;
  }

  .tool-chip {
    border: 1px solid rgba(15, 23, 42, 0.1);
    border-radius: 10px;
    background: #ffffff;
    padding: 14px 20px;
    color: #0b1220;
    font-size: 14px;
    font-weight: 600;
    box-shadow: 0 8px 20px rgba(15, 23, 42, 0.04);
  }

  /* ---------- CTA ---------- */

  .cta {
    position: relative;
    background: linear-gradient(180deg, #061426, #0a1c38);
    padding: 110px 0;
    overflow: hidden;
    text-align: center;
  }

  .cta::before {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 900px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(29, 99, 255, 0.22),
      transparent 70%
    );
    content: "";
    filter: blur(20px);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    width: min(720px, calc(100% - 48px));
    margin: 0 auto;
  }

  .cta h2 {
    max-width: none;
    margin: 0 auto;
  }

  .cta-description {
    margin: 20px auto 34px;
    color: rgba(245, 247, 250, 0.65);
    font-size: 16px;
    line-height: 1.6;
  }

  .cta .primary-button {
    display: inline-flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: 5px;
    padding: 0 24px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 180ms ease;
  }

  .cta .primary-button:hover {
    transform: translateY(-2px);
  }

  /* ---------- Footer ---------- */

  footer {
    background: #030d1b;
    padding-top: 70px;
  }

  .footer-inner {
    display: grid;
    width: min(1180px, calc(100% - 48px));
    grid-template-columns: 1.4fr 1fr 1.2fr 1fr;
    gap: 30px;
    margin: 0 auto;
    padding-bottom: 50px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .footer-tagline {
    max-width: 220px;
    margin: 16px 0 18px;
    color: rgba(245, 247, 250, 0.55);
    font-size: 13.5px;
    line-height: 1.5;
  }

  .footer-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
    color: rgba(245, 247, 250, 0.5);
    font-size: 13px;
  }

  .footer-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #45c7ff;
  }

  .footer-icon :global(svg) {
    width: 15px;
    height: 15px;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .footer-heading {
    margin: 0 0 4px;
    color: rgba(245, 247, 250, 0.4);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer-column a {
    color: rgba(245, 247, 250, 0.68);
    font-size: 13.5px;
    text-decoration: none;
  }

  .footer-column a:hover {
    color: #45c7ff;
  }

  .footer-link-icon {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: rgba(245, 247, 250, 0.68);
    font-size: 13.5px;
  }

  .footer-note {
    margin: 0;
